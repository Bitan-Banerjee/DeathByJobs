# AI Job Pipeline — Environment variables
# Copy this file to .env and fill in the API key for your chosen provider.

# Example for Google Gemini (default / free-tier friendly)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Example for OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Example for Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Example for local / Ollama (usually not required)
# LOCAL_API_KEY=not-needed

# Platform credentials
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password
